  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\VS_Code\AGV\AGV_Test\build\cmake\stm32cubemx && C:\CMake\bin\cmake-gui.exe -SD:\VS_Code\AGV\AGV_Test -BD:\VS_Code\AGV\AGV_Test\build"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build cmake/stm32cubemx/edit_cache: phony cmake/stm32cubemx/CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build cmake/stm32cubemx/CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\WINDOWS\system32\cmd.exe /C "cd /D D:\VS_Code\AGV\AGV_Test\build\cmake\stm32cubemx && C:\CMake\bin\cmake.exe --regenerate-during-build -SD:\VS_Code\AGV\AGV_Test -BD:\VS_Code\AGV\AGV_Test\build"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build cmake/stm32cubemx/rebuild_cache: phony cmake/stm32cubemx/CMakeFiles/rebuild_cache.util


